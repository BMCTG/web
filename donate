<!-- ===== 4. DONATION OPTIONS ===== -->
<section class="section">
  <div class="container">
    <div class="section-center reveal">
      <div class="section-tag">Donate</div>
      <h2 class="section-title">Choose how you want to help</h2>
      <p class="section-desc">Every contribution, large or small, directly supports the deaf and mute community in Gandhinagar. Pick the method that works best for you.</p>
    </div>

    <div class="donate-grid">

      <!-- UPI Donation Card -->
      <div class="donate-card reveal delay-1">
        <div class="donate-card__header">
          <h3>📱 UPI Donation</h3>
          <p>Scan the QR code or use our UPI ID to donate instantly.</p>
        </div>
        <div class="donate-card__body">
          <div class="qr-placeholder" aria-label="QR Code placeholder">QR</div>
          <div class="upi-id-box">
            <span>UPI ID</span>
            <strong>bmctg@upi</strong>
          </div>
          <a href="contact.html" class="btn btn-primary btn-lg" style="width:100%">Donate via UPI</a>
        </div>
      </div>

      <!-- Bank Transfer Card -->
      <div class="donate-card reveal delay-2">
        <div class="donate-card__header">
          <h3>🏦 Bank Transfer</h3>
          <p>Donate directly via bank transfer using the details below.</p>
        </div>
        <div class="donate-card__body">
          <div class="bank-detail">
            <span class="bank-detail__label">Account Name</span>
            <span class="bank-detail__value">Badhir Mandal Charitable Trust</span>
          </div>
          <div class="bank-detail">
            <span class="bank-detail__label">Bank Name</span>
            <span class="bank-detail__value">[Bank Name]</span>
          </div>
          <div class="bank-detail">
            <span class="bank-detail__label">Account No.</span>
            <span class="bank-detail__value">[Account Number]</span>
          </div>
          <div class="bank-detail">
            <span class="bank-detail__label">IFSC Code</span>
            <span class="bank-detail__value">[IFSC Code]</span>
          </div>
          <div style="margin-top:24px">
            <a href="contact.html" class="btn btn-primary btn-lg" style="width:100%">Donate via Bank Transfer</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

