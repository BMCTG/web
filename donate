          <li>Donation receipt</li>
        </ul>
        <a href="contact.html" class="btn btn-primary btn-md" style="width:100%">Sponsor Now</a>
      </div>

      <!-- Tier 4 — Featured -->
      <div class="tier-card featured reveal delay-4">
        <div class="tier-card__name">Team Sponsor</div>
        <div class="tier-card__price">&#8377;50,000</div>
        <div class="tier-card__desc">Team Sponsorship</div>
        <ul class="tier-card__features">
          <li>Sponsor an entire team</li>
          <li>All equipment &amp; kits</li>
          <li>Tournament travel costs</li>
          <li>Name on team banner</li>
          <li>Donation receipt</li>
        </ul>
        <a href="contact.html" class="btn btn-accent btn-md" style="width:100%">Sponsor Now</a>
      </div>

